# TigerGraph connection
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPHNAME=fraud_investigation
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_secret

# LLM (use whichever you have)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Model selection
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Agent settings
MAX_INVESTIGATION_ITERATIONS=5
CONFIDENCE_THRESHOLD_ACT=0.75
CONFIDENCE_THRESHOLD_GATHER=0.50

# GraphRAG (TigerGraph built-in)
GRAPHRAG_ENABLED=true
